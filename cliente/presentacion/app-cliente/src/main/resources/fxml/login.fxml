<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- C1 · Inicio de sesión (mockups_cliente.md). Formulario de ancho fijo, centrado aunque la ventana crezca. -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.universidad.mensajeria.cliente.vistas.VistaLogin" styleClass="login">
    <VBox spacing="8" alignment="TOP_CENTER" maxWidth="360" maxHeight="-Infinity" StackPane.alignment="CENTER">
        <padding>
            <Insets top="12" right="12" bottom="12" left="12"/>
        </padding>

        <!-- Ícono de conversación vectorial: no depende de que exista una fuente de emoji (R-70). -->
        <SVGPath styleClass="login-icono" scaleX="2" scaleY="2"
                 content="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z">
            <VBox.margin>
                <Insets top="8" bottom="14"/>
            </VBox.margin>
        </SVGPath>
        <Label text="Mensajería Académica Unillanos" styleClass="login-titulo" wrapText="true"/>
        <Label text="Ingresa con tu código institucional" styleClass="texto-suave"/>

        <VBox spacing="4">
            <VBox.margin>
                <Insets top="18"/>
            </VBox.margin>

            <Label text="Código" styleClass="login-etiqueta"/>
            <TextField fx:id="txtCodigo" promptText="Ej. 20201001"/>

            <Label text="Contraseña" styleClass="login-etiqueta">
                <VBox.margin>
                    <Insets top="8"/>
                </VBox.margin>
            </Label>
            <PasswordField fx:id="txtClave"/>

            <Label text="Servidor (cliente.properties)" styleClass="login-etiqueta">
                <VBox.margin>
                    <Insets top="8"/>
                </VBox.margin>
            </Label>
            <HBox spacing="6">
                <TextField fx:id="txtServidor" promptText="host : puerto" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="cmbProtocolo" prefWidth="84"/>
            </HBox>
        </VBox>

        <Button fx:id="btnIngresar" text="Ingresar" defaultButton="true" onAction="#onIngresar"
                styleClass="boton-primario" maxWidth="Infinity">
            <VBox.margin>
                <Insets top="18"/>
            </VBox.margin>
        </Button>

        <Label fx:id="lblError" styleClass="error" maxWidth="Infinity" wrapText="true"/>
    </VBox>
</StackPane>
