<mxCell id="SerializadorJSON" value='&lt;div align="center"&gt;«Jackson»&lt;br&gt;&lt;b&gt;SerializadorJSON&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- mapper : ObjectMapper' style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#546E7A;" vertex="1" parent="1"><mxGeometry x="1354" y="1631" width="160" height="63" as="geometry"/></mxCell>
<mxCell id="IGeneradorHash" value='&lt;div align="center"&gt;«interface»&lt;br&gt;&lt;i&gt;&lt;b&gt;IGeneradorHash&lt;/b&gt;&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;+ generar(datos : byte[]) : String' style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacingLeft=6;fontSize=10;fillColor=#EDE7F6;strokeColor=#7E57C2;" vertex="1" parent="1"><mxGeometry x="1354" y="1710" width="220" height="63" as="geometry"/></mxCell>
<mxCell id="GeneradorHashSHA256" value='&lt;div align="center"&gt;&lt;b&gt;GeneradorHashSHA256&lt;/b&gt;&lt;/div&gt;' style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#546E7A;" vertex="1" parent="1"><mxGeometry x="1354" y="1789" width="160" height="31" as="geometry"/></mxCell>
<mxCell id="nCfg" value="&lt;b&gt;cliente.properties&lt;/b&gt;&lt;br&gt;servidor.host=192.168.1.10&lt;br&gt;servidor.puerto=5000&lt;br&gt;h2.url=jdbc:h2:./data/cliente_{codigo}&lt;br&gt;h2.usuario=sa · h2.clave=&lt;br&gt;cache.mensajes.max=500&lt;br&gt;logs: SLF4J + Logback → logs/cliente.log" style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="390" y="2045" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="nProto" value='&lt;b&gt;Protocolo (independiente del lenguaje)&lt;/b&gt;&lt;br&gt;Trama TCP: [int32 longitud][JSON UTF-8]&lt;br&gt;→ {"idPeticion":"7f1","comando":"ENVIAR_PRIVADO",&lt;br&gt;&amp;nbsp;&amp;nbsp;"parametros":{"destino":"160004512"},&lt;br&gt;&amp;nbsp;&amp;nbsp;"contenido":{"tipo":"TEXTO","texto":"Hola"}}&lt;br&gt;← {"idPeticion":"7f1","exito":true,"mensaje":"OK","datos":{…}}&lt;br&gt;⇐ push {"tipo":"MENSAJE_NUEVO","datos":{"canal":"FORO",…}}&lt;br&gt;Cualquier cliente (Python, C#, JS…) puede implementarlo.' style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="714" y="2045" width="380" height="170" as="geometry"/></mxCell>
<mxCell id="nH2" value="&lt;b&gt;Persistencia de la sesión (H2)&lt;/b&gt;&lt;br&gt;Todo lo que el usuario genera y recibe en su sesión se guarda localmente: SESION(id, codigo, ip_servidor, inicio, fin) · MENSAJE(id, sesion_id, canal, remitente, destinatario, tipo, contenido, hash, fecha) · ADJUNTO(id, mensaje_id, nombre, datos BLOB)." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1118" y="2045" width="330" height="130" as="geometry"/></mxCell>
<mxCell id="nUI" value="&lt;b&gt;Experiencia de usuario&lt;/b&gt;&lt;br&gt;VistaChat: lista de usuarios conectados (todos visibles), pestaña Foro, una pestaña por conversación privada (incluido ADMIN) y barra de estado «Estoy conectado a: 192.x.x.x». VistaInformes muestra los 4 informes JSON del servidor en tablas." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1472" y="2045" width="330" height="130" as="geometry"/></mxCell>
<mxCell id="nRoot" value="&lt;b&gt;Composition Root (AppCliente)&lt;/b&gt;&lt;br&gt;Lee ConfiguracionCliente, obtiene IConexionServidor de FabricaConexiones, crea repositorios H2 (FabricaRepositoriosH2), servicios y FachadaCliente, e inyecta IFachadaCliente en los ViewModels. Los push del servidor llegan por DespachadorEventosServidor → FachadaCliente → IObservadorCliente (Platform.runLater)." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="36" y="2045" width="330" height="140" as="geometry"/></mxCell>
<mxCell id="title" value="&lt;b style='font-size:24px'&gt;Mensajería Académica Unillanos — Diagrama de clases por componentes · CLIENTE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#546E7A'&gt;Java 21 + JavaFX (MVVM) · protocolo intercambiable (TCP · UDP · gRPC) · H2 embebido por sesión · DIP + DI + fábricas · SLF4J/Logback · octubre 2026&lt;/span&gt;" style="text;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1500" height="60" as="geometry"/></mxCell>
