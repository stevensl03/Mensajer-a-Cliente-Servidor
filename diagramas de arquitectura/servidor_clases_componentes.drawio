<mxCell id="ISerializador" value='&lt;div align="center"&gt;«interface»&lt;br&gt;&lt;i&gt;&lt;b&gt;ISerializador&lt;/b&gt;&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;+ aJson(o : Object) : String&lt;br&gt;+ desdeJson(s : String, tipo : Class&amp;lt;T&amp;gt;) : T' style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacingLeft=6;fontSize=10;fillColor=#EDE7F6;strokeColor=#7E57C2;" vertex="1" parent="1"><mxGeometry x="1746" y="3557" width="270" height="75" as="geometry"/></mxCell>
<mxCell id="SerializadorJSON" value='&lt;div align="center"&gt;«Jackson»&lt;br&gt;&lt;b&gt;SerializadorJSON&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- mapper : ObjectMapper' style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#546E7A;" vertex="1" parent="1"><mxGeometry x="1746" y="3648" width="160" height="63" as="geometry"/></mxCell>
<mxCell id="UtilImagen" value='&lt;div align="center"&gt;&lt;b&gt;UtilImagen&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;+ aBytes(img : BufferedImage, fmt : String) : byte[]  {static}&lt;br&gt;+ desdeBytes(datos : byte[]) : BufferedImage  {static}' style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacingLeft=6;fontSize=10;fillColor=#FFFFFF;strokeColor=#546E7A;" vertex="1" parent="1"><mxGeometry x="1746" y="3727" width="370" height="63" as="geometry"/></mxCell>
<mxCell id="nCfg" value="&lt;b&gt;servidor.properties&lt;/b&gt;&lt;br&gt;servidor.puerto=5000&lt;br&gt;servidor.maxSesiones=10 &lt;i&gt;(N, cupo global)&lt;/i&gt;&lt;br&gt;servidor.vista=CONSOLA | ESCRITORIO&lt;br&gt;cola.hilosConsumidores=4&lt;br&gt;cache.l1.max=5000 · cache.l1.ttl=10m&lt;br&gt;redis.host=localhost · redis.puerto=6379 · redis.ttl=1h&lt;br&gt;archivos.directorio=./almacen&lt;br&gt;usuarios.archivoInicial=./usuarios.txt&lt;br&gt;&lt;b&gt;bd.properties&lt;/b&gt;&lt;br&gt;bd.motor=MYSQL | POSTGRESQL&lt;br&gt;bd.url=jdbc:mysql://localhost:3306/mensajeria&lt;br&gt;bd.usuario / bd.clave · bd.pool=10" style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2224" y="3645" width="330" height="210" as="geometry"/></mxCell>
<mxCell id="nRoot" value="&lt;b&gt;Composition Root (ServidorApp)&lt;/b&gt;&lt;br&gt;Único punto donde se instancian clases concretas: carga ConfiguracionServidor, usa FabricaRepositorios, FabricaCaches, FabricaFiltros, FabricaManejadoresComando y FabricaProtocolos, inyecta por constructor y entrega IFachadaServidor a la vista creada por FabricaVistas. El resto del sistema depende solo de interfaces (DIP)." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2578" y="3395" width="330" height="130" as="geometry"/></mxCell>
<mxCell id="nCupo" value="&lt;b&gt;Cupo global de sesiones&lt;/b&gt;&lt;br&gt;registrar() ⇒ cupo.tryAcquire(). maxSesiones = N cuenta TODAS las sesiones activas; un mismo usuario puede abrir varias. Si un usuario ocupa las N, los demás reciben CUPO_LLENO y no pueden interactuar. cerrar() ⇒ cupo.release()." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2578" y="3545" width="330" height="120" as="geometry"/></mxCell>
<mxCell id="nChat" value="&lt;b&gt;Mensajería tipo chat&lt;/b&gt;&lt;br&gt;FORO ⇒ EnrutadorMensajes entrega a todas las sesiones.&lt;br&gt;PRIVADO ⇒ sesiones del destinatario + remitente.&lt;br&gt;El ADMIN opera desde VistaConsola / VistaEscritorio (usuario especial con Rol.ADMIN): publica, envía privados y los recibe vía IObservadorServidor." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2932" y="3395" width="330" height="130" as="geometry"/></mxCell>
<mxCell id="nFiltros" value="&lt;b&gt;Procesamiento&lt;/b&gt;&lt;br&gt;Texto: SHA-256 + nº caracteres + nº palabras.&lt;br&gt;Imagen: SHA-256 y 5 filtros ejecutados &lt;b&gt;secuencialmente&lt;/b&gt; (escala de grises → sepia → rotar 180° → brillo → reducción); cada filtro genera una imagen nueva que se guarda en ./almacen/filtradas y se referencia en la BD." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2932" y="3545" width="330" height="130" as="geometry"/></mxCell>
<mxCell id="nCache" value="&lt;b&gt;Caché de dos niveles + estructuras&lt;/b&gt;&lt;br&gt;Lectura: L1 Caffeine → L2 Redis → BD (read-through).&lt;br&gt;Escritura: estructuras en memoria (HashMap / Deque / Queue) + write-through a la BD e invalidación L1/L2.&lt;br&gt;Se cachean mensajes, conversaciones, logs filtrados (FiltroLogs) e imágenes filtradas." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="3286" y="3395" width="330" height="130" as="geometry"/></mxCell>
<mxCell id="nLog" value="&lt;b&gt;Gestor de logs: SLF4J + Logback&lt;/b&gt;&lt;br&gt;logback.xml: ConsoleAppender con %highlight (colores por nivel) y RollingFileAppender diario (30 días). MDC: usuario, ip, canal.&lt;br&gt;LogEventos además indexa en memoria (por tipo / usuario) para informes y persiste en la tabla logs_eventos." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="3286" y="3545" width="330" height="130" as="geometry"/></mxCell>
<mxCell id="nInf" value="&lt;b&gt;Informes en JSON&lt;/b&gt;&lt;br&gt;GeneradorInformes serializa con ISerializador: USUARIOS_REGISTRADOS, USUARIOS_CONECTADOS (cantidad de sesiones por usuario), MENSAJES (detalle) y LOGS. Los ve la vista del servidor y cualquier cliente (comando INFORME)." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="3640" y="3395" width="330" height="120" as="geometry"/></mxCell>
<mxCell id="legend" value="&lt;b style='font-size:13px'&gt;Convenciones&lt;/b&gt;&lt;br&gt;&lt;span style='background:#FFF2CC;border:1px solid #D6B656'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Componente / clase principal&lt;br&gt;&lt;span style='background:#EDE7F6;border:1px solid #7E57C2'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Interfaz (&lt;i&gt;cursiva&lt;/i&gt;)&lt;br&gt;&lt;span style='background:#FCE4EC;border:1px solid #D81B60'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Fábrica (Factory / Abstract Factory)&lt;br&gt;&lt;span style='background:#E3F2FD;border:1px solid #1E88E5'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Enumeración&lt;br&gt;&lt;span style='background:#F1F8E9;border:1px solid #7CB342'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Record / DTO&lt;br&gt;&lt;span style='background:#E0F2F1;border:1px solid #00897B'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Infraestructura (caché, pool, config)&lt;br&gt;&lt;span style='border:1px dashed #9E9E9E'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Alternativa configurable&lt;br&gt;&lt;br&gt;—○ componente provee interfaz · ⇢▷ realiza · —▷ hereda&lt;br&gt;→ asociación · ⇢ dependencia «usa/crea» · ◆ composición · ◇ agregación&lt;br&gt;&lt;font color='#C62828'&gt;&lt;b&gt;━▶&lt;/b&gt;&lt;/font&gt; acceso a recurso externo" style="text;align=left;verticalAlign=top;fontSize=11;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2224" y="3395" width="330" height="230" as="geometry"/></mxCell>
<mxCell id="title" value="&lt;b style='font-size:24px'&gt;Mensajería Académica Unillanos — Diagrama de clases por componentes · SERVIDOR&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#546E7A'&gt;Java 21 · protocolo intercambiable (TCP · UDP · gRPC) · arquitectura en capas · DIP + DI + fábricas · MySQL / PostgreSQL (JDBC) · caché L1 Caffeine + L2 Redis · SLF4J/Logback · octubre 2026&lt;/span&gt;" style="text;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1600" height="60" as="geometry"/></mxCell>
