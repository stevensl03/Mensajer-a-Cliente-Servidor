<mxCell id="gMsg" value="Esquema de mensajería" style="shape=folder;tabPosition=left;tabHeight=20;fillColor=#F3F8FB;strokeColor=#90A4AE;verticalAlign=top;align=left;spacingLeft=10;spacingTop=1;fontSize=11;fontStyle=1;fontColor=#263238;html=1;whiteSpace=wrap;container=0;tabWidth=181;" vertex="1" parent="1"><mxGeometry x="410" y="106" width="1062" height="514" as="geometry"/></mxCell>
<mxCell id="gUsr" value="Catálogo de usuarios (lo escribe solo AlmacenarInformación)" style="shape=folder;tabPosition=left;tabHeight=20;fillColor=#F3F8FB;strokeColor=#90A4AE;verticalAlign=top;align=left;spacingLeft=10;spacingTop=1;fontSize=11;fontStyle=1;fontColor=#263238;html=1;whiteSpace=wrap;container=0;tabWidth=270;" vertex="1" parent="1"><mxGeometry x="20" y="106" width="300" height="191" as="geometry"/></mxCell>
<mxCell id="usuarios" value="&lt;div align=&quot;center&quot;&gt;«tabla»&lt;br&gt;&lt;b&gt;usuarios&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;PK  codigo : VARCHAR(20)&lt;br&gt;nombres : VARCHAR(100) NOT NULL&lt;br&gt;apellidos : VARCHAR(100) NOT NULL&lt;br&gt;contrasena_hash : CHAR(64) NOT NULL&lt;br&gt;programa : VARCHAR(120) NOT NULL&lt;br&gt;rol : VARCHAR(10) NOT NULL&lt;hr&gt;CK  rol IN ('USUARIO', 'ADMIN')" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacingLeft=6;fontSize=10;fillColor=#E8F5E9;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="36" y="138" width="220" height="143" as="geometry"/></mxCell>
<mxCell id="conexiones_usuario" value='&lt;div align="center"&gt;«tabla»&lt;br&gt;&lt;b&gt;conexiones_usuario&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;PK  id_conexion : CHAR(36)  «UUID»&lt;br&gt;codigo_usuario : VARCHAR(20) NOT NULL&lt;br&gt;ip_remota : VARCHAR(45) NOT NULL&lt;br&gt;fecha_conexion : TIMESTAMP(3) NOT NULL&lt;br&gt;fecha_desconexion : TIMESTAMP(3) NULL&lt;hr&gt;IX  (codigo_usuario, fecha_desconexion)' style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacingLeft=6;fontSize=10;fillColor=#FFF8E1;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="426" y="138" width="250" height="131" as="geometry"/></mxCell>
<mxCell id="mensajes" value="&lt;div align=&quot;center&quot;&gt;«tabla»&lt;br&gt;&lt;b&gt;mensajes&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;PK  id : CHAR(36)  «UUID»&lt;br&gt;remitente_codigo : VARCHAR(20) NOT NULL&lt;br&gt;destinatario_codigo : VARCHAR(20) NULL  «NULL = foro»&lt;br&gt;conversacion_id : VARCHAR(41) NULL  «menor|mayor»&lt;br&gt;canal : VARCHAR(10) NOT NULL&lt;br&gt;tipo_mensaje : VARCHAR(10) NOT NULL&lt;br&gt;fecha_envio : TIMESTAMP(3) NOT NULL&lt;br&gt;hash_sha256 : CHAR(64) NOT NULL  «contenido original»&lt;hr&gt;CK  canal IN ('FORO', 'PRIVADO')&lt;br&gt;CK  tipo_mensaje IN ('TEXTO', 'IMAGEN')&lt;br&gt;CK  (canal='FORO' AND destinatario_codigo IS NULL)&lt;br&gt;       OR (canal='PRIVADO' AND destinatario_codigo IS NOT NULL)&lt;br&gt;IX  (canal, fecha_envio)&lt;br&gt;IX  (conversacion_id, fecha_envio)" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacingLeft=6;fontSize=10;fillColor=#FFF8E1;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="906" y="138" width="380" height="227" as="geometry"/></mxCell>
<mxCell id="mensajes_texto" value='&lt;div align="center"&gt;«tabla»&lt;br&gt;&lt;b&gt;mensajes_texto&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;PK, FK  mensaje_id : CHAR(36)&lt;br&gt;contenido : TEXT NOT NULL&lt;br&gt;num_caracteres : INT NOT NULL&lt;br&gt;num_palabras : INT NOT NULL' style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacingLeft=6;fontSize=10;fillColor=#FFF8E1;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="906" y="425" width="190" height="99" as="geometry"/></mxCell>
<mxCell id="imagenes_mensaje" value="&lt;div align=&quot;center&quot;&gt;«tabla»&lt;br&gt;&lt;b&gt;imagenes_mensaje&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;PK  id : CHAR(36)  «UUID»&lt;br&gt;FK  mensaje_id : CHAR(36) NOT NULL&lt;br&gt;etapa : VARCHAR(20) NOT NULL&lt;br&gt;nombre_archivo : VARCHAR(255) NOT NULL&lt;br&gt;ruta_archivo : VARCHAR(500) NOT NULL  «./almacen/...»&lt;br&gt;tamano_bytes : BIGINT NOT NULL&lt;br&gt;hash_sha256 : CHAR(64) NOT NULL&lt;hr&gt;UQ  (mensaje_id, etapa)&lt;br&gt;CK  etapa IN ('ORIGINAL', 'ESCALA_GRISES', 'SEPIA',&lt;br&gt;       'ROTAR_180', 'BRILLO', 'REDUCCION_TAMANO')" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacingLeft=6;fontSize=10;fillColor=#FFF8E1;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1136" y="425" width="320" height="179" as="geometry"/></mxCell>
<mxCell id="logs_eventos" value="&lt;div align=&quot;center&quot;&gt;«tabla»&lt;br&gt;&lt;b&gt;logs_eventos&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;PK  id : CHAR(36)  «UUID»&lt;br&gt;tipo : VARCHAR(20) NOT NULL&lt;br&gt;descripcion : TEXT NOT NULL&lt;br&gt;fecha_hora : TIMESTAMP(3) NOT NULL&lt;br&gt;usuario_codigo : VARCHAR(20) NULL&lt;br&gt;ip : VARCHAR(45) NULL&lt;hr&gt;CK  tipo IN ('CONEXION', 'DESCONEXION', 'LOGIN_OK', 'LOGIN_FALLIDO',&lt;br&gt;       'CUPO_LLENO', 'MENSAJE_FORO', 'MENSAJE_PRIVADO', 'ERROR')&lt;br&gt;IX  (fecha_hora, tipo)&lt;br&gt;IX  (usuario_codigo)" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;overflow=fill;spacingLeft=6;fontSize=10;fillColor=#FBE9E7;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="426" y="329" width="410" height="179" as="geometry"/></mxCell>
<mxCell id="src" value="&lt;b&gt;config/usuarios.txt&lt;/b&gt; → carga inicial&lt;br&gt;AlmacenarInformación (ImportadorUsuarios) lo importa a la tabla usuarios al iniciar si está vacía y entrega la lista al componente Usuarios, que no conoce la persistencia. Las demás tablas referencian el código sin FK." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="327" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="n2" value="&lt;b&gt;Notas de implementación (portable MySQL · PostgreSQL)&lt;/b&gt;&lt;br&gt;• Claves UUID generadas por la aplicación; sin AUTO_INCREMENT / IDENTITY.&lt;br&gt;• Valores enumerados con VARCHAR + CHECK (no ENUM).&lt;br&gt;• TIMESTAMP(3) en el modelo; Flyway mantiene un script por motor (db/migration/mysql y db/migration/postgresql; en MySQL se declara DATETIME(3)).&lt;br&gt;• Archivos en ./almacen/originales, ./almacen/filtradas y ./almacen/textos; la BD guarda ruta, tamaño y hash.&lt;br&gt;• Mensaje + sus 6 imágenes en UNA transacción.&lt;br&gt;• Al iniciar: cerrar conexiones huérfanas (fecha_desconexion IS NULL).&lt;br&gt;• conexiones_usuario es el historial; los conectados y su cantidad de sesiones salen de la memoria (ConexionesClientes).&lt;br&gt;• Todo acceso a estas tablas pasa por AlmacenarInformación → Persistencia.&lt;br&gt;• Las estructuras en memoria (AlmacenMensajesMemoria, LogEventos) espejan estas tablas con write-through." style="shape=note;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1532" y="106" width="420" height="230" as="geometry"/></mxCell>
<mxCell id="title" value="&lt;b style='font-size:22px'&gt;Modelo relacional — Mensajería Académica · SERVIDOR&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#546E7A'&gt;Portable: MySQL · PostgreSQL (JDBC + Flyway)&lt;/span&gt;" style="text;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1100" height="56" as="geometry"/></mxCell>
<mxCell id="e0" value="1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;startArrow=ERzeroToOne;startFill=0;endArrow=ERmandOne;endFill=0;startSize=12;endSize=12;strokeColor=#455A64;" edge="1" parent="1" source="mensajes_texto" target="mensajes"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="1 : 1..6" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;startArrow=ERmany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=12;endSize=12;strokeColor=#455A64;" edge="1" parent="1" source="imagenes_mensaje" target="mensajes"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="remitente / destinatario  (referencia lógica, sin FK)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;endArrow=none;dashed=1;dashPattern=2 4;strokeColor=#9E9E9E;" edge="1" parent="1" source="mensajes" target="usuarios"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="codigo_usuario  (referencia lógica, sin FK)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;endArrow=none;dashed=1;dashPattern=2 4;strokeColor=#9E9E9E;" edge="1" parent="1" source="conexiones_usuario" target="usuarios"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="usuario_codigo  (referencia lógica, sin FK)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;endArrow=none;dashed=1;dashPattern=2 4;strokeColor=#9E9E9E;" edge="1" parent="1" source="logs_eventos" target="usuarios"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>