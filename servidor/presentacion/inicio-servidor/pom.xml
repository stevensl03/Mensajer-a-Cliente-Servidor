<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.universidad</groupId>
        <artifactId>mensajeria-servidor</artifactId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>inicio-servidor</artifactId>
    <name>Presentacion - Inicio Servidor (raiz de ejecucion)</name>
    <dependencies>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>dto-records</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>utilerias-varias</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>fachada</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>interfaz-protocolo-comunicacion</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>interfaz-cliente-servidor</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>interfaz-servicios-disponibles</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>interfaz-usuarios-disponibles</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>interfaz-gestor-mensajes</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>protocolo-comunicacion</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>protocolo-cliente-servidor</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>servicios</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>usuarios</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>gestor-colas-de-mensajes</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>mensajes</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>log-de-eventos</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>conexiones-clientes</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>almacenar-informacion</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>persistencia</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>fachada-de-servicios</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>vista-consola</artifactId>
        </dependency>
        <dependency>
            <groupId>com.universidad</groupId>
            <artifactId>vista-escritorio</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Jar ejecutable con todas las dependencias: java -jar inicio-servidor-1.0.0.jar (desde servidor/). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.universidad.mensajeria.inicio.ServidorApp</mainClass>
                                </transformer>
                                <!-- SLF4J (proveedor Logback) y Flyway (bases de datos) se registran por ServiceLoader. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
